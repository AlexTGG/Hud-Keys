{
	"schemaVersion": 1,
	"id": "hudk",
	"version": "${version}",
	"name": "Hud Keys",
	"description": "Shows key presses on the in-game HUD (displays keybind names and states).",
	"authors": [
		"AlexTGG"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/hud-keys",
		"sources": "https://github.com/AlexTGG/Hud-Keys",
		"issues": "https://github.com/AlexTGG/Hud-Keys/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/hudk/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"hudkeys.hudk.HudKeys"
		],
		"client": [
			"hudkeys.hudk.HudKeysClient"
		]
	},
	"mixins": [
		"hudk.mixins.json",
		{
			"config": "hudk.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}